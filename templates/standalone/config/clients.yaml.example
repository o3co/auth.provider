# Example client definitions loaded via loadYamlMap into InMemoryClientRepository.
# Copy this file to clients.yaml and customize for your deployment.
#
# `tokenEndpointAuthMethod` is REQUIRED (RFC 6749 §2.3 / RFC 7591 §2):
#   - "client_secret_basic": HTTP Basic Authorization header — recommended for confidential clients
#   - "client_secret_post":  form-encoded body parameters
#   - "none":                public client — no clientSecret; PKCE/S256 mandatory at /authorize
#
# Secret format (only for confidential clients — basic / post):
#   - Bcrypt hash: "$2b$10$..."  <-- use this
#   - Plain text: "my-secret"     <-- accepted, for local development only
#
# Generate a real one:
#   SECRET=$(openssl rand -base64 32)
#   node -e "require('bcrypt').hash(process.argv[1],10).then(console.log)" "$SECRET"
# Give $SECRET to the client; put the hash in this file.
#
# #407: the schema accepts any non-empty string here, unlike `session.secret`
# and the JWT signing secret, which have carried a 256-bit floor since #282.
# That is deliberate — this field also holds a bcrypt hash, whose shape those
# floors would reject — but it means NOTHING stops you from shipping
# `clientSecret: "changeme"`. A client secret authenticates a confidential
# client at the token endpoint; treat it as you would any other credential
# and give it 256 bits of randomness.
#
# `firstParty` (#267): REQUIRED to be `true` for a client to use `/authorize`.
#   `/authorize` mints a code as soon as the session is authenticated, with no
#   consent step, so a forced top-level navigation from an attacker's page
#   makes a logged-in user's browser mint one for whatever client is named.
#   That is defensible for clients you operate and only for those. Mark a
#   client `firstParty: true` only if you would be comfortable with it
#   receiving the user's identity without the user being asked.
#
#   A client without it is refused at `/authorize`, as is one carrying an
#   explicit `firstParty: false`. There is no opt-out: mark every client you
#   operate before pointing it at `/authorize`.
#
# `allowPlainPkce` (#273): PKCE is mandatory for EVERY client — confidential
#   ones included — and `S256` is the only method accepted. There is no
#   server-wide setting that changes either half. This per-client flag is the
#   one exception hatch, and only for the method: `allowPlainPkce: true` lets
#   that one client use the RFC 7636 `plain` challenge, which stores the
#   verifier itself as the challenge and so proves nothing against anyone who
#   can read the authorization request. Set it only for a legacy client that
#   genuinely cannot compute SHA-256, and treat it as a migration deadline.

my-app:
  tokenEndpointAuthMethod: "client_secret_basic"
  firstParty: true
  clientSecret: "$2b$10$REPLACE_WITH_BCRYPT_HASH"
  allowedRedirectUris:
    - "http://localhost:3000/callback"
  allowedScopes:
    - "read"
    - "write"
  # What an omitted `scope` parameter grants (#396). Must be a subset of
  # allowedScopes (checked at boot). Without this, a request that omits
  # `scope` is refused with invalid_scope — the old behavior granted the
  # ENTIRE allowlist, which made "forgot to send scope" the maximum grant.
  # Declare what an unscoped request should mean, not the ceiling.
  defaultScopes:
    - "read"

# Public client example (e.g., a single-page app or mobile app):
# my-spa:
#   tokenEndpointAuthMethod: "none"
#   firstParty: true
#   # clientSecret MUST be absent for "none" clients.
#   allowedRedirectUris:
#     - "https://app.example/callback"
#   allowedScopes:
#     - "openid"
#     - "profile"

# Legacy client that cannot compute SHA-256 (#273). Prefer fixing the client.
# my-legacy-device:
#   tokenEndpointAuthMethod: "client_secret_basic"
#   firstParty: true
#   clientSecret: "$2b$10$REPLACE_WITH_BCRYPT_HASH"
#   allowPlainPkce: true
#   allowedRedirectUris:
#     - "https://legacy.example/callback"
#   allowedScopes:
#     - "openid"
