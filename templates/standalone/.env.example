# Canonical issuer stamped as `iss` on every token this deployment mints.
# Absolute https URL (http only for a loopback host), no query or fragment.
# Boot fails when unset — it is never derived from the Host header.
OAUTH_JWT_ISSUER=

# --- JWT signing key (required) ---------------------------------------------
# The default algorithm is EdDSA (Ed25519). There is no key-material default:
# a deployment that sets none fails at boot naming the keys to set, rather than
# quietly signing with something guessable.
#
#   openssl genpkey -algorithm ed25519 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#
# Keep jwt-private.pem out of version control and off the image.
OAUTH_JWT_PRIVATE_KEY_PATH=./jwt-private.pem
OAUTH_JWT_PUBLIC_KEY_PATH=./jwt-public.pem
# OAUTH_JWT_ALGORITHM=EdDSA          # EdDSA | ES256 | RS256 | HS256
# OAUTH_JWT_KID=v0
#
# HS256 alternative — symmetric, so /.well-known/jwks.json publishes NOTHING
# and every relying party must hold a secret that can also MINT tokens. Only
# for deployments that verify in-process. Needs >= 32 bytes (256 bits):
#   openssl rand -hex 32
# Hex/base64 values are measured DECODED, so a 32-character hex string counts
# as 16 bytes and is refused.
# OAUTH_JWT_ALGORITHM=HS256
# OAUTH_JWT_SECRET=

# --- Session (required) ------------------------------------------------------
# Signs the cookie that IS the authenticated session, so guessing it forges
# logins. Same >= 32-byte floor and same decoded measurement:
#   openssl rand -hex 32
SESSION_SECRET=

# User repository
# Both URLs carry plaintext user credentials to the upstream store, so both must
# be absolute https URLs. http:// is accepted only for a loopback host
# (localhost, 127.0.0.0/8, [::1]) — a private-range address or a compose service
# name such as http://user-service:8080 still needs https. Boot fails otherwise.
CLIENT_USER_AUTHENTICATE_URL=
CLIENT_USER_AUTHENTICATE_BY_TOKEN_URL=

# --- Reverse proxy (required in production) -----------------------------------
# Express `trust proxy`. Set this to the address or CIDR range of whatever
# terminates TLS in front of this service — `10.0.0.0/8`, or `loopback` for a
# sidecar on the same host. Comma-separate several.
#
# Prefer naming the hop over `true`: `true` believes a forwarded client address
# from anyone who can reach this process, and with it any rate-limit identity.
# Left EMPTY here because it cannot be guessed; `docker-compose.production.yml`
# refuses to start until it is set, since without it the Secure cookie is never
# set, the CSRF origin check 403s every browser POST, and every IP-keyed rate
# limit shares one bucket. A plain-HTTP local run needs nothing here.
HTTP_TRUST_PROXY=

# Redis (code repository + session storage + the shared client socket)
# Use redis://redis:6379 when running via docker compose
CLIENT_CODE_ENDPOINT_URI=redis://redis:6379
SESSION_STORAGE_REDIS_URL=redis://redis:6379
# #407: this one backs the SHARED ioredis socket -- the refresh-token family
# store, the access-token denylist and the rate limiter all ride on it. It
# defaults to redis://localhost:6379, which inside the container is the
# container, so leaving it unset makes the compose boot dial nothing.
REFRESH_TOKEN_FAMILY_STORE_REDIS_URL=redis://redis:6379

# Development (override for local HTTP).
# The default cookie name carries the `__Host-` prefix, which browsers only
# accept on a Secure cookie — so dropping Secure means renaming the cookie too,
# or boot refuses the combination.
SESSION_SECURE=false
SESSION_NAME=auth.sid

# Optional
# HTTP_PORT=3000
# OAUTH_ACCESS_TOKEN_EXPIRES_IN=3600
# OAUTH_REFRESH_TOKEN_EXPIRES_IN=86400
# SESSION_MAX_AGE=3600000
# SESSION_SAME_SITE=lax             # `none` additionally requires SESSION_SECURE=true
