# Canonical issuer stamped as `iss` on every token this deployment mints.
# Absolute https URL (http only for a loopback host), no query or fragment.
# Boot fails when unset — it is never derived from the Host header.
OAUTH_JWT_ISSUER=

# --- JWT signing key (required) ---------------------------------------------
# The default algorithm is EdDSA (Ed25519). There is no key-material default:
# a deployment that sets none fails at boot naming the keys to set, rather than
# quietly signing with something guessable.
#
#   openssl genpkey -algorithm ed25519 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
#
# Keep jwt-private.pem out of version control and off the image.
KEY_STORE_LOCAL_PRIVATE_KEY_PATH=./jwt-private.pem
KEY_STORE_LOCAL_PUBLIC_KEY_PATH=./jwt-public.pem
# KEY_STORE_LOCAL_ALGORITHM=EdDSA          # EdDSA | ES256 | RS256 | HS256
# KEY_STORE_LOCAL_KID=v0
#
# HS256 alternative — symmetric, so /.well-known/jwks.json publishes NOTHING
# and every relying party must hold a secret that can also MINT tokens. Only
# for deployments that verify in-process. Needs >= 32 bytes (256 bits):
#   openssl rand -hex 32
# Hex/base64 values are measured DECODED, so a 32-character hex string counts
# as 16 bytes and is refused.
# KEY_STORE_LOCAL_ALGORITHM=HS256
# KEY_STORE_LOCAL_SECRET=

# --- Session (required) ------------------------------------------------------
# Signs the cookie that IS the authenticated session, so guessing it forges
# logins. Same >= 32-byte floor and same decoded measurement:
#   openssl rand -hex 32
SESSION_STORE_SECRET=

# User repository
# Both URLs carry plaintext user credentials to the upstream store, so both must
# be absolute https URLs. http:// is accepted only for a loopback host
# (localhost, 127.0.0.0/8, [::1]) — a private-range address or a compose service
# name such as http://user-service:8080 still needs https. Boot fails otherwise.
# Each must be the endpoint that answers: no request follows a 3xx, so a URL that
# redirects fails every call.
REPOSITORIES_USER_HTTP_AUTHENTICATE_URL=
REPOSITORIES_USER_HTTP_AUTHENTICATE_BY_TOKEN_URL=
# With MFA on: the Store's endpoint the MFA enrollment witness is written to,
# so a Store that loses a subject's factors cannot open a first binding to
# whoever holds the password. Your Store must then answer `mfaEnrolled` on
# both URLs above. Unset, boot warns (mfa_enrollment_witness_unwritable).
# REPOSITORIES_USER_HTTP_MARK_MFA_ENROLLED_URL=https://users.example.com/mfa/enrolled
# The credential this server presents to the Store: every Store request carries
# `Authorization: Bearer <token>`. Without one, anyone who can reach the Store
# can resolve an identity to its user, so your Store should refuse any request
# without it, with 401 and `WWW-Authenticate: Bearer error="invalid_token"`
# (which this server then reports as an outage naming the refused credential).
# The one token goes to every Store URL above: they must be one trust domain.
# At least 32 bytes, measured like SESSION_STORE_SECRET; boot fails on a weak or
# malformed value. Left commented out because a blank value is refused too:
#   openssl rand -hex 32
# REPOSITORIES_USER_HTTP_BEARER_TOKEN=

# --- Reverse proxy (required in production) -----------------------------------
# Express `trust proxy`. Set this to the address or CIDR range of whatever
# terminates TLS in front of this service — `10.0.0.0/8`, or `loopback` for a
# sidecar on the same host. Comma-separate several.
#
# Prefer naming the hop over `true`: `true` believes a forwarded client address
# from anyone who can reach this process, and with it any rate-limit identity.
# Left EMPTY here because it cannot be guessed; `docker-compose.production.yml`
# refuses to start until it is set, since without it the Secure cookie is never
# set, the CSRF origin check 403s every browser POST, and every IP-keyed rate
# limit shares one bucket. A plain-HTTP local run needs nothing here.
HTTP_TRUST_PROXY=

# Redis (session storage + the shared client socket)
# Use redis://redis:6379 when running via docker compose
SESSION_STORE_STORAGE_REDIS_URL=redis://redis:6379
# #407: this one backs the SHARED ioredis socket -- the refresh-token family
# store, the access-token denylist and the rate limiter all ride on it. It
# defaults to redis://localhost:6379, which inside the container is the
# container, so leaving it unset makes the compose boot dial nothing.
REDIS_CLIENTS_URL=redis://redis:6379

# --- Federation grants (#593, optional) --------------------------------------
# Offline delegation of an upstream IdP's tokens to a backend or an agent, on a
# consent that survives logout. Off by default; on, boot refuses what is
# missing by name. The consent page is yours (README: Federation Grants). The
# connections and the encryption key ring are lists, so they live in a HOCON
# layer, not here. Both stores ship as none: select each (redis, or memory on
# one replica) with the two ADAPTERS_ lines below. Redis GRANTS need
# ADAPTERS_USER_SESSION_STORES=redis beside them (the compose files set it) —
# the grants would outlive a memory boundary that ends them.
# FEDERATION_GRANTS_ENABLED=true
# FEDERATION_GRANTS_CONSENT_URL=/consent/grants
# `required` seals credentials under redis-federation-grant-store.encryptionKeys (HOCON);
# `allow-plaintext` is refused in production/staging and under multi.
# REDIS_FEDERATION_GRANT_STORE_ENCRYPTION_MODE=required
# `required` needs a user repository that covers every connection's
# registration: the shipped http one asks your Store at the URL below and
# covers what repositories.user.http.federatedIdentityLookupCoverage (HOCON)
# declares; `unsupported` records that the check is not made.
# FEDERATION_GRANTS_IDENTITY_LOOKUP=required
# REPOSITORIES_USER_HTTP_FIND_SUBJECT_BY_FEDERATED_IDENTITY_URL=https://users.example.com/find-subject-by-federated-identity
# ADAPTERS_FEDERATION_GRANT_STORE=redis
# ADAPTERS_FEDERATION_GRANT_INTENT_STORE=redis

# --- Multi-factor authentication (optional) ----------------------------------
# MFA_MODE installs it: off (the default) | optional | required. On, set a key
# of your own and, outside development, the SMTP relay the account-email proof
# and the email factor's codes go through. The MFA page is yours (README:
# Multi-factor authentication). The two MFA stores ship in memory, which a
# restart empties of every factor: memory is refused outside development and
# test, so production selects redis (or, for the factors, store).
# MFA_MODE=required
#   openssl rand -base64 32
# MFA_ENCRYPTION_KEY=
# MFA_PAGE_URL=/mfa
# STANDARD_SMTP_MAIL_SENDER_HOST=smtp.example.com
# STANDARD_SMTP_MAIL_SENDER_FROM=auth@example.com
# To read that mail in development, leave these unset and run the Mailpit
# overlay, which sets them (README: Mailpit for the SMTP sender):
#   docker compose -f docker-compose.yml -f docker-compose.mailpit.yml up --build
# ADAPTERS_MFA_FACTOR_STORE=redis
# ADAPTERS_MFA_TRANSACTION_STORE=redis

# Development (override for local HTTP).
# The default cookie name carries the `__Host-` prefix, which browsers only
# accept on a Secure cookie — so dropping Secure means renaming the cookie too,
# or boot refuses the combination.
SESSION_STORE_SECURE=false
SESSION_STORE_NAME=auth.sid

# Optional
# HTTP_PORT=3000
# OAUTH_ACCESS_TOKEN_DEFAULT_EXPIRES_IN=3600
# The most a token-exchange `expires_in` can obtain; unset = the default.
# OAUTH_ACCESS_TOKEN_MAX_EXPIRES_IN=3600
# DEPRECATED alias of OAUTH_ACCESS_TOKEN_DEFAULT_EXPIRES_IN, read only while
# that one is unset.
# OAUTH_ACCESS_TOKEN_EXPIRES_IN=3600
# OAUTH_REFRESH_TOKEN_EXPIRES_IN=86400
# SESSION_STORE_MAX_AGE=3600000
# SESSION_STORE_SAME_SITE=lax             # `none` additionally requires SESSION_STORE_SECURE=true
