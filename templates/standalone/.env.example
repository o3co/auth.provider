# Required
OAUTH_JWT_SECRET=
SESSION_SECRET=

# User repository
CLIENT_USER_AUTHENTICATE_URL=
CLIENT_USER_AUTHENTICATE_BY_TOKEN_URL=

# Redis (code repository + session storage)
CLIENT_CODE_ENDPOINT_URI=redis://localhost:6379
SESSION_STORAGE_REDIS_URL=redis://localhost:6379

# Development (override for local HTTP)
SESSION_SECURE=false

# Optional
# HTTP_PORT=3000
# OAUTH_JWT_ISSUER=
# OAUTH_ACCESS_TOKEN_EXPIRES_IN=3600
# OAUTH_REFRESH_TOKEN_EXPIRES_IN=86400
