{
	"name": "@o3co/auth-provider-redis",
	"description": "Redis-backed adapters (ChallengeStore, ReplaySeenSet) for @o3co/auth-provider-core",
	"version": "0.0.0",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=18.19.0"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./dpop": {
			"import": "./dist/dpop-replay-store.mjs",
			"types": "./dist/dpop-replay-store.d.mts"
		},
		"./ioredis": {
			"import": "./dist/ioredis.mjs",
			"types": "./dist/ioredis.d.mts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/o3co/auth.provider.git",
		"directory": "packages/redis"
	},
	"imports": {
		"#/*": {
			"development": "./src/*",
			"default": "./dist/*"
		}
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"@o3co/auth-provider-core": "^0.0.0",
		"@o3co/auth-provider-dpop": "^0.0.0",
		"ioredis": "^5.11.0",
		"redis": "^5.10.0"
	},
	"peerDependenciesMeta": {
		"@o3co/auth-provider-dpop": {
			"optional": true
		},
		"ioredis": {
			"optional": true
		},
		"redis": {
			"optional": true
		}
	},
	"devDependencies": {
		"@o3co/auth-provider-core": "workspace:*",
		"@o3co/auth-provider-dpop": "workspace:*",
		"@vitest/coverage-v8": "^4.1.6",
		"ioredis": "^5.11.0",
		"redis": "^5.10.0",
		"testcontainers": "^12.0.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	}
}
