{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "."
	},
	// vitest's typecheck runs tsc on this program, and an error in any file of
	// it fails the run, whether or not `typecheck.include` in vitest.config.mts
	// names the file. `tsconfig.json` builds `src` alone, so every test file and
	// helper comes in here by glob: a new one is compiled without being listed.
	"include": ["src/**/*.mts", "__tests__/**/*.mts"],
	"exclude": ["node_modules", "dist"]
}
