{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "."
	},
	// #626: `tsconfig.json` builds `src` alone, so pointing vitest's typecheck
	// at it left `__tests__/types.test.mts` outside the program — its
	// assertions passed without ever being compiled. Paired with
	// `typecheck.include` in vitest.config.mts: a file in only one of the two
	// looks checked but is not.
	"include": [
		"src/**/*.mts",
		"__tests__/types.test.mts",
		"__tests__/code-repository.test.mts",
		"__tests__/device-code-store.test.mts",
		"__tests__/adapters.device-code-store.contract.mts",
		"__tests__/federation-grant-intent-store-codec.test.mts",
		"__tests__/federation-grant-intent-store.integration.test.mts",
		"__tests__/adapters.federation-grant-intent-store.contract.mts",
		"__tests__/federation-grant-store.order.test.mts",
		"__tests__/federation-grant-store.faults.integration.test.mts",
		"__tests__/federation-grant-primitives.integration.test.mts",
		"__tests__/federation-grant-store.integration.test.mts",
		"__tests__/adapters.federation-grant-store.contract.mts",
		"__tests__/internal/federation-grant-codec.test.mts"
	],
	"exclude": ["node_modules", "dist"]
}
