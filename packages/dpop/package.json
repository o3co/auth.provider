{
	"name": "@o3co/auth-provider-dpop",
	"version": "0.0.0",
	"description": "DPoP (RFC 9449) sender-constrained access token support for @o3co/auth-provider",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./reference.conf": "./config/reference.conf"
	},
	"files": [
		"dist",
		"config",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/o3co/auth.provider.git",
		"directory": "packages/dpop"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"imports": {
		"#/*": {
			"development": "./src/*",
			"default": "./dist/*"
		}
	},
	"peerDependencies": {
		"@o3co/auth-provider-core": "workspace:^",
		"express": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		}
	},
	"dependencies": {
		"jose": "^6.2.12",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@o3co/auth-provider-core": "workspace:*",
		"@o3co/ts.hocon": "^1.13.0",
		"@types/express": "^5.0.6",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.0",
		"express": "^5.0.0",
		"supertest": "^7.2.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
