{
	"name": "@o3co/auth-provider-smtp",
	"description": "An SMTP MailSender for @o3co/auth-provider — how multi-factor authentication's codes and notices leave the provider. Its module declares its section and provides no sender.",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./reference.conf": "./config/reference.conf"
	},
	"files": [
		"dist",
		"config",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/o3co/auth.provider.git",
		"directory": "packages/smtp"
	},
	"imports": {
		"#/*": {
			"development": "./src/*",
			"default": "./dist/*"
		}
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@o3co/auth-provider-core": "workspace:^"
	},
	"devDependencies": {
		"@o3co/auth-provider-core": "workspace:*",
		"@o3co/ts.hocon": "^1.13.0",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.2"
	}
}
