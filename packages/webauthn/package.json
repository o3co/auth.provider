{
	"name": "@o3co/auth-provider-webauthn",
	"description": "WebAuthn first slice for @o3co/auth-provider — primary-login passkeys, AS-scope only.",
	"version": "0.0.0",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.0.0"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./testing": {
			"types": "./dist/testing/index.d.mts",
			"import": "./dist/testing/index.mjs"
		},
		"./reference.conf": "./config/reference.conf"
	},
	"files": [
		"dist",
		"config",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/o3co/auth.provider.git",
		"directory": "packages/webauthn"
	},
	"imports": {
		"#/*": {
			"development": "./src/*",
			"default": "./dist/*"
		}
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@simplewebauthn/server": "14.0.1",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@o3co/auth-provider-core": "workspace:^",
		"express": "^5.0.0"
	},
	"devDependencies": {
		"@o3co/auth-provider-core": "workspace:*",
		"@o3co/auth-provider-mfa": "workspace:*",
		"@o3co/auth-provider-session": "workspace:*",
		"@o3co/auth-provider-test-kit": "workspace:*",
		"@o3co/ts.hocon": "^1.13.0",
		"@types/express": "^5.0.6",
		"@types/supertest": "^7.2.1",
		"express": "^5.2.1",
		"supertest": "^7.3.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.2",
		"@vitest/coverage-v8": "^5.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
