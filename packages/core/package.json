{
	"name": "@o3co/auth-provider-core",
	"description": "Core types, config, and utilities for auth.provider",
	"version": "0.0.0",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=18.19.0"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./modules/manifest": {
			"import": "./dist/modules/manifest/index.mjs",
			"types": "./dist/modules/manifest/index.d.mts"
		},
		"./testing": {
			"types": "./dist/testing/index.d.mts",
			"import": "./dist/testing/index.mjs"
		},
		"./middleware/express.mjs": {
			"import": "./dist/middleware/express.mjs",
			"types": "./dist/middleware/express.d.mts"
		},
		"./reference.conf": "./config/reference.conf"
	},
	"files": [
		"dist",
		"config",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/o3co/auth.provider.git",
		"directory": "packages/core"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"imports": {
		"#/*": {
			"development": "./src/*",
			"default": "./dist/*"
		}
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"jose": "^6.2.2",
		"js-yaml": "^4.1.1",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"express": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		}
	},
	"devDependencies": {
		"@o3co/ts.hocon": "^1.2.0",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.9.1",
		"@types/supertest": "^7.2.0",
		"express": "^5.2.1",
		"pino": "^10.3.1",
		"supertest": "^7.2.2",
		"vitest": "^4.1.6",
		"@vitest/coverage-v8": "^4.1.8"
	}
}
