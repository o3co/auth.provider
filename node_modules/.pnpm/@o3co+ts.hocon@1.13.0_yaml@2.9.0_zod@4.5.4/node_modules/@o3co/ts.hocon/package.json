{
  "name": "@o3co/ts.hocon",
  "version": "1.13.0",
  "description": "Full Lightbend HOCON spec-compliant parser and config library for TypeScript",
  "keywords": [
    "hocon",
    "config",
    "configuration",
    "parser",
    "typescript",
    "lightbend"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./adapters/properties": {
      "import": {
        "types": "./dist/adapters/properties.d.ts",
        "default": "./dist/adapters/properties.js"
      },
      "require": {
        "types": "./dist/adapters/properties.d.cts",
        "default": "./dist/adapters/properties.cjs"
      }
    },
    "./adapters/env": {
      "import": {
        "types": "./dist/adapters/env.d.ts",
        "default": "./dist/adapters/env.js"
      },
      "require": {
        "types": "./dist/adapters/env.d.cts",
        "default": "./dist/adapters/env.cjs"
      }
    },
    "./adapters/jsonc": {
      "import": {
        "types": "./dist/adapters/jsonc.d.ts",
        "default": "./dist/adapters/jsonc.js"
      },
      "require": {
        "types": "./dist/adapters/jsonc.d.cts",
        "default": "./dist/adapters/jsonc.cjs"
      }
    },
    "./adapters/json5": {
      "import": {
        "types": "./dist/adapters/json5.d.ts",
        "default": "./dist/adapters/json5.js"
      },
      "require": {
        "types": "./dist/adapters/json5.d.cts",
        "default": "./dist/adapters/json5.cjs"
      }
    },
    "./adapters/toml": {
      "import": {
        "types": "./dist/adapters/toml.d.ts",
        "default": "./dist/adapters/toml.js"
      },
      "require": {
        "types": "./dist/adapters/toml.d.cts",
        "default": "./dist/adapters/toml.cjs"
      }
    },
    "./adapters/yaml": {
      "import": {
        "types": "./dist/adapters/yaml.d.ts",
        "default": "./dist/adapters/yaml.js"
      },
      "require": {
        "types": "./dist/adapters/yaml.d.cts",
        "default": "./dist/adapters/yaml.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "zod": ">=4.0.0",
    "smol-toml": ">=1.0.0",
    "yaml": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "smol-toml": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "4.1.10",
    "js-yaml": "^4.3.1",
    "smol-toml": "^1.7.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o3co/ts.hocon.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://o3co.github.io/ts.hocon/",
  "bugs": "https://github.com/o3co/ts.hocon/issues",
  "scripts": {
    "build": "tsup",
    "smoke": "tsup && node tools/smoke-entrypoints.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "docs": "typedoc"
  }
}