# tools/live-check profile — Google (the check o3co/auth.provider#600 asked for).
#
#   cp google.env.example google.env     # google.env is git-ignored
#
# The Google Cloud OAuth client (type "Web application") needs this exact
# authorized redirect URI (the port is LIVE_CHECK_PORT, 3210 by default):
#
#   http://localhost:3210/session/oauth/federation/google/callback
#
# and, while the consent screen is in "Testing", the Google account you will
# sign in with listed as a test user.
LIVE_CHECK_FEDERATION=google
LIVE_CHECK_EXPECTED_ISS=https://accounts.google.com
FEDERATIONS_GOOGLE_CLIENT_ID=
FEDERATIONS_GOOGLE_CLIENT_SECRET=
