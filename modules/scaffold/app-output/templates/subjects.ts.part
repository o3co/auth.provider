{{guard}}
import { randomBytes } from "node:crypto";

// The app and every module it composes are read only now, past the guard: one that throws as it is
// read ends the run as a boot that failed.
const notRead = () => end("failed: the app could not be built: start it with this configuration to read why", 1);
const [{ legacyVariablesCheck, loadConfig }, { assemble, BootRefused, isUnavailable }, { {{contract}} }, ...composed] =
	await Promise.all([import("{{configFiles}}"), import("{{kernel}}"), import("{{entry}}"), {{reads}}]).catch(notRead);
/** A boot that could not be built: how many refusals, where they can be counted (exit 78), or that it failed (exit 1). */
const notBuilt = (error: unknown): never => {
	if (!BootRefused.is(error)) return notRead();
	const n: unknown = (error as { refusals?: { length?: unknown } }).refusals?.length;
	const many = Number.isSafeInteger(n) && (n as number) >= 0 ? ` ${n}` : "";
	return end(`refused${many}: start the app with this configuration to read why`, 78);
};
/** The longest subject, in bytes. */
const longest = 255;

/**
 * Each line of standard input as it was sent, without its line ending, or undefined for a line
 * longer than a subject may be. No more of a line than that is ever held.
 */
async function* lines(input: AsyncIterable<Buffer>): AsyncGenerator<string | undefined> {
	let held: Buffer[] = [];
	let size = 0;
	// One byte more, for a carriage return before the line feed.
	const hold = (part: Buffer) => {
		size += part.length;
		held = size > longest + 1 ? [] : [...held, part];
	};
	const line = () => {
		const text = size > longest + 1 ? undefined : Buffer.concat(held).toString("utf8").replace(/\r$/, "");
		held = [];
		size = 0;
		return text === undefined || Buffer.byteLength(text) > longest ? undefined : text;
	};
	for await (const chunk of input) {
		let from = 0;
		for (let at = chunk.indexOf(10); at !== -1; at = chunk.indexOf(10, from)) {
			hold(chunk.subarray(from, at));
			yield line();
			from = at + 1;
		}
		hold(chunk.subarray(from));
	}
	if (size > 0) yield line();
}

// The script writes no log line, which could carry a subject.
const quiet = () => undefined;
const runtime = {
	clock: { now: () => Date.now() },
	random: { bytes: (length: number) => new Uint8Array(randomBytes(length)) },
	log: { trace: quiet, debug: quiet, info: quiet, warn: quiet, error: quiet, fatal: quiet },
};

// The app as `start` builds it, never started: no route is served while the script runs.
const files = (process.env.APP_CONFIG ?? "config/application.conf").split(",");
const source = { files, env: process.env };
const app = await loadConfig(source)
	.then(async (config) => {
		// A variable 0.17 read, left in the environment, is told once, named by none, or refuses boot, as config-files says.
		const told = await legacyVariablesCheck(source);
		if (told !== undefined) {
			tell(2, "warn variables 0.17 read are set and never read: start the app to name them\n");
		}
		return assemble({ modules: composed.map((read) => read.default), config, runtime });
	})
	.catch(notBuilt);
