{{refused}}
// A script reading subjects tells only fixed lines and counts: no subject, configured value or error's
// words, which may hold either. The app's own start tells why, run with the same configuration.
/** Writes a fixed line on standard error and exits with `code`, telling nothing else. */
const ended = async (line: string, code: number): Promise<never> => {
	await written(process.stderr, `${line}\n`).catch(() => undefined);
	process.exit(code);
};
// Whatever is thrown outside a subject's own call ends the run alike.
const unexpected = () => ended("failed: the run stopped on an unexpected error", 1);
process.on("uncaughtException", unexpected);
process.on("unhandledRejection", unexpected);
/** A boot that could not be built: how many refusals (exit 78), or that it failed (exit 1). */
const notBuilt = (error: unknown): Promise<never> =>
	BootRefused.is(error)
		? ended(`refused ${error.refusals.length}: start the app with this configuration to read why`, 78)
		: ended("failed: the app could not be built: start it with this configuration to read why", 1);
/** The longest subject, in bytes. */
const longest = 255;

/**
 * Each line of standard input as it was sent, without its line ending, or undefined for a line
 * longer than a subject may be. No more of a line than that is ever held.
 */
async function* lines(input: AsyncIterable<Buffer>): AsyncGenerator<string | undefined> {
	let held: Buffer[] = [];
	let size = 0;
	// One byte more, for a carriage return before the line feed.
	const hold = (part: Buffer) => {
		size += part.length;
		held = size > longest + 1 ? [] : [...held, part];
	};
	const line = () => {
		const text = size > longest + 1 ? undefined : Buffer.concat(held).toString("utf8").replace(/\r$/, "");
		held = [];
		size = 0;
		return text === undefined || Buffer.byteLength(text) > longest ? undefined : text;
	};
	for await (const chunk of input) {
		let from = 0;
		for (let at = chunk.indexOf(10); at !== -1; at = chunk.indexOf(10, from)) {
			hold(chunk.subarray(from, at));
			yield line();
			from = at + 1;
		}
		hold(chunk.subarray(from));
	}
	if (size > 0) yield line();
}

// The script writes no log line, which could carry a subject.
const quiet = () => undefined;
const runtime = {
	clock: { now: () => Date.now() },
	random: { bytes: (length: number) => new Uint8Array(randomBytes(length)) },
	log: { trace: quiet, debug: quiet, info: quiet, warn: quiet, error: quiet, fatal: quiet },
};

// The app as `start` builds it, never started: no route is served while the script runs.
const files = (process.env.APP_CONFIG ?? "config/application.conf").split(",");
const source = { files, env: process.env };
const app = await loadConfig(source)
	.then(async (config) => {
		// A variable 0.17 read, left in the environment, is told once, named by none, or refuses boot, as config-files says.
		const told = await legacyVariablesCheck(source);
		if (told !== undefined) {
			await written(
				process.stderr,
				"warn variables 0.17 read are set and never read: start the app to name them\n",
			);
		}
		return assemble({ modules: [{{modules}}], config, runtime });
	})
	.catch(notBuilt);
