import { assemble, BootRefused, loadConfig } from "{{kernel}}";
import { resealing } from "{{seal}}";
{{imports}}

/** A refused boot: each refusal on its own line of standard error, then exit 78. */
const refused = (error: unknown): never => {
	if (!(error instanceof BootRefused)) throw error;
	for (const refusal of error.refusals) {
		process.stderr.write(`refused ${refusal.where}: ${refusal.reason}\n`);
	}
	process.exit(78);
};

// The app as `start` builds it, never started: no route is served while values are sealed again.
const files = (process.env.APP_CONFIG ?? "config/application.conf").split(",");
const app = await loadConfig({ files, env: process.env })
	.then((config) => assemble({ modules: [{{modules}}], config }))
	.catch(refused);
const told = await app.get(resealing).reseal();
for (const holder of told) {
	const counts = "failed" in holder ? "failed" : `resealed ${holder.resealed} left ${holder.left}`;
	process.stdout.write(`${holder.name} ${counts}\n`);
}
// 1: a holder failed and should run again; 2: values no key opens remain, so no key may go yet.
process.exit(told.some((h) => "failed" in h) ? 1 : told.some((h) => "left" in h && h.left > 0) ? 2 : 0);
