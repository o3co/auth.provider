{
	"name": "@mod/federation",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "adapter",
	"takesSamples": [
		{
			"map": "federation.idps",
			"of": "@mod/upstreams"
		}
	],
	"replaces": "@mod/upstreams",
	"default": true,
	"asks": [
		"A login a gate holds goes on at `federation.held-page`, a page on the public origin, written in the local layer; without it, the browser stops at the gate's answer."
	],
	"exports": {
		"./module": "./src/module.ts",
		"./testing": "./src/testing.ts",
		"./audit-events": "./src/audit-events.ts"
	},
	"dependencies": {
		"@mod/audit": "workspace:*",
		"@mod/csrf": "workspace:*",
		"@mod/http": "workspace:*",
		"@mod/kernel": "workspace:*",
		"@mod/login-attributes": "workspace:*",
		"@mod/login-gates": "workspace:*",
		"@mod/rate-limit": "workspace:*",
		"@mod/request-source": "workspace:*",
		"@mod/upstream-handoff": "workspace:*",
		"@mod/upstream-round-trip": "workspace:*",
		"@mod/upstreams": "workspace:*",
		"@mod/url-setting": "workspace:*",
		"@mod/users": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@mod/cookies": "workspace:*",
		"@mod/federation-link": "workspace:*",
		"@mod/records": "workspace:*",
		"@mod/seal": "workspace:*",
		"@mod/secret-hash": "workspace:*",
		"@mod/session": "workspace:*",
		"@mod/store": "workspace:*",
		"@mod/subject-revocation": "workspace:*",
		"@mod/upstream-handoff": "workspace:*",
		"@mod/upstream-handoff-seal": "workspace:*",
		"@mod/upstream-round-trip": "workspace:*",
		"vitest": "5.0.5"
	}
}
