{
	"name": "@mod/mail-smtp",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "adapter",
	"network": "smtp",
	"replaces": "@mod/mail",
	"asks": [
		"Mail through an SMTP relay (`mail-smtp.host`, `mail-smtp.from`; `mail-smtp.user` and `mail-smtp.password` in the local layer when it asks)."
	],
	"exports": {
		"./module": "./src/module.ts"
	},
	"dependencies": {
		"@mod/address-reach": "workspace:*",
		"@mod/kernel": "workspace:*",
		"@mod/mail": "workspace:*",
		"@mod/tls-options": "workspace:*",
		"@mod/url-setting": "workspace:*",
		"nodemailer": "10.2.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"vitest": "5.0.5"
	}
}
