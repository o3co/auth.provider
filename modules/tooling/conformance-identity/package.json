{
	"name": "@mod/conformance-identity",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "verification",
	"exports": {
		".": "./src/main.ts"
	},
	"scripts": {
		"conformance": "vitest run --config vitest.config.ts",
		"conformance:faults": "SPEC_EVIDENCE_RUN=faults vitest run --config vitest.faults.config.ts",
		"evidence-runs": "node -p \"JSON.stringify([{ entry: '@mod/conformance-identity#faults', kind: 'faults', matrix: '@mod/conformance-identity', files: '.faults.case.ts', noSkip: true }])\""
	},
	"dependencies": {
		"@mod/conformance": "workspace:*",
		"@mod/conformance-legacy": "workspace:*",
		"@mod/ledger-fakes": "workspace:*",
		"bcryptjs": "3.0.3"
	},
	"devDependencies": {
		"@mod/conformance-keys": "workspace:*",
		"@mod/spec-checklist": "workspace:*",
		"vitest": "5.0.5"
	}
}
