{
	"alias": "{ALIAS}",
	"description": "o3co behind the harness's front, logging out (PKCE adaptation)",
	"server": {
		"discoveryUrl": "{ORIGIN}/.well-known/openid-configuration"
	},
	"client": {
		"client_id": "client",
		"client_secret": "{SECRET_CLIENT}"
	},
	"client2": {
		"client_id": "client2",
		"client_secret": "{SECRET_CLIENT2}"
	},
	"client_secret_post": {
		"client_id": "client_secret_post",
		"client_secret": "{SECRET_POST}"
	},
	"browser": [
		{
			"match": "{ORIGIN}/oauth/authorize*",
			"tasks": [
				{
					"task": "Login",
					"optional": true,
					"match": "{ORIGIN}/login*",
					"commands": [
						["text", "name", "username", "{USERNAME}"],
						["text", "name", "password", "{PASSWORD}"],
						["click", "name", "login"]
					]
				},
				{
					"task": "Verify Complete",
					"match": "*/test/*/callback*",
					"commands": [["wait", "id", "submission_complete", 10]]
				}
			]
		},
		{
			"match": "{ORIGIN}/oauth/logout*",
			"tasks": [
				{
					"task": "Wait for the redirect back to the suite (the logout URL names the return in its query, so the wait is anchored at the suite's origin), by the page's script after its frames where it frames any",
					"optional": true,
					"match": "{ORIGIN}/oauth/logout*",
					"commands": [
						[
							"wait",
							"match",
							"^https://localhost\\.emobix\\.co\\.uk:8443/test/a/[^/?]+/post_logout_redirect",
							10
						]
					]
				},
				{
					"task": "Verify Complete",
					"match": "*/test/*/post*"
				}
			]
		}
	],
	"override": {
		"oidcc-rp-initiated-logout-bad-post-logout-redirect-uri": {
			"browser": [
				{
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "{ORIGIN}/login*",
							"commands": [
								["text", "name", "username", "{USERNAME}"],
								["text", "name", "password", "{PASSWORD}"],
								["click", "name", "login"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				},
				{
					"comment": "the return is not registered: the provider refuses the request as invalid, logging no one out and sending the browser nowhere",
					"match": "{ORIGIN}/oauth/logout*",
					"tasks": [
						{
							"task": "Expect the provider's own answer",
							"match": "{ORIGIN}/oauth/logout*",
							"commands": [
								[
									"wait",
									"xpath",
									"//*",
									10,
									"post_logout_redirect_uri is not registered",
									"update-image-placeholder"
								]
							]
						}
					]
				}
			]
		},
		"oidcc-rp-initiated-logout-query-added-to-post-logout-redirect-uri": {
			"browser": [
				{
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "{ORIGIN}/login*",
							"commands": [
								["text", "name", "username", "{USERNAME}"],
								["text", "name", "password", "{PASSWORD}"],
								["click", "name", "login"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				},
				{
					"comment": "the return is not registered: the provider refuses the request as invalid, logging no one out and sending the browser nowhere",
					"match": "{ORIGIN}/oauth/logout*",
					"tasks": [
						{
							"task": "Expect the provider's own answer",
							"match": "{ORIGIN}/oauth/logout*",
							"commands": [
								[
									"wait",
									"xpath",
									"//*",
									10,
									"post_logout_redirect_uri is not registered",
									"update-image-placeholder"
								]
							]
						}
					]
				}
			]
		},
		"oidcc-rp-initiated-logout-no-post-logout-redirect-uri": {
			"browser": [
				{
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "{ORIGIN}/login*",
							"commands": [
								["text", "name", "username", "{USERNAME}"],
								["text", "name", "password", "{PASSWORD}"],
								["click", "name", "login"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				},
				{
					"comment": "no return: the provider logs out and answers that it logged out, sending the browser nowhere",
					"match": "{ORIGIN}/oauth/logout*",
					"tasks": [
						{
							"task": "Expect the provider's own answer",
							"match": "{ORIGIN}/oauth/logout*",
							"commands": [["wait", "xpath", "//*", 10, "logged_out", "update-image-placeholder"]]
						}
					]
				}
			]
		},
		"oidcc-rp-initiated-logout-modified-id-token-hint": {
			"browser": [
				{
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "{ORIGIN}/login*",
							"commands": [
								["text", "name", "username", "{USERNAME}"],
								["text", "name", "password", "{PASSWORD}"],
								["click", "name", "login"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				},
				{
					"comment": "a hint the provider refuses",
					"match": "{ORIGIN}/oauth/logout*",
					"tasks": [
						{
							"task": "Expect the provider's own answer",
							"match": "{ORIGIN}/oauth/logout*",
							"commands": [
								["wait", "xpath", "//*", 10, "invalid_token", "update-image-placeholder"]
							]
						}
					]
				}
			]
		},
		"oidcc-rp-initiated-logout-bad-id-token-hint": {
			"browser": [
				{
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Login",
