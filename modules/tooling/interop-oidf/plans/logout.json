					"match": "{ORIGIN}/oauth/logout*",
					"tasks": [
						{
							"task": "Expect the provider's own answer",
							"match": "{ORIGIN}/oauth/logout*",
							"commands": [
								["wait", "xpath", "//*", 10, "invalid_token", "update-image-placeholder"]
							]
						}
					]
				}
			]
		},
		"oidcc-rp-initiated-logout-no-id-token-hint": {
			"browser": [
				{
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "{ORIGIN}/login*",
							"commands": [
								["text", "name", "username", "{USERNAME}"],
								["text", "name", "password", "{PASSWORD}"],
								["click", "name", "login"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				},
				{
					"comment": "the provider asks the person to confirm a logout without a hint, on its own page, and never returns from it; the suite asks for the question",
					"match": "{ORIGIN}/oauth/logout*",
					"tasks": [
						{
							"task": "Show the question asked, then confirm the logout",
							"match": "{ORIGIN}/oauth/logout/confirm*",
							"commands": [
								[
									"wait",
									"xpath",
									"//*",
									10,
									"Do you want to log out of",
									"update-image-placeholder"
								],
								["click", "xpath", "//button[@type='submit']"]
							]
						},
						{
							"task": "Expect the provider's logged-out page",
							"match": "{ORIGIN}/oauth/logout/confirm*",
							"commands": [["wait", "xpath", "//*", 10, "You are logged out"]]
						}
					]
				}
			]
		},
