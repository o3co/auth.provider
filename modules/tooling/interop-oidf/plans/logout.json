						}
					]
				},
				{
					"comment": "the provider asks the person to confirm a logout without a hint, on its own page, and never returns from it",
					"match": "{ORIGIN}/oauth/logout*",
					"tasks": [
						{
							"task": "Confirm the logout",
							"match": "{ORIGIN}/oauth/logout/confirm*",
							"commands": [["click", "xpath", "//button[@type='submit']"]]
						},
						{
							"task": "Expect the provider's logged-out page",
							"match": "{ORIGIN}/oauth/logout/confirm*",
							"commands": [
								["wait", "xpath", "//*", 10, "You are logged out", "update-image-placeholder"]
							]
						}
					]
				}
			]
		},
