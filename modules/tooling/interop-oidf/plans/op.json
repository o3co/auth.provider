{
	"alias": "{ALIAS}",
	"description": "o3co behind the harness's front (PKCE adaptation)",
	"server": {
		"discoveryUrl": "{ORIGIN}/.well-known/openid-configuration"
	},
	"client": {
		"client_id": "client",
		"client_secret": "{SECRET_CLIENT}"
	},
	"client2": {
		"client_id": "client2",
		"client_secret": "{SECRET_CLIENT2}"
	},
	"client_secret_post": {
		"client_id": "client_secret_post",
		"client_secret": "{SECRET_POST}"
	},
	"browser": [
		{
			"match": "{ORIGIN}/oauth/authorize*",
			"tasks": [
				{
					"task": "Login",
					"optional": true,
					"match": "{ORIGIN}/login*",
					"commands": [
						["text", "name", "username", "{USERNAME}"],
						["text", "name", "password", "{PASSWORD}"],
						["click", "name", "login"]
					]
				},
				{
					"task": "Verify Complete",
					"match": "*/test/*/callback*",
					"commands": [["wait", "id", "submission_complete", 10]]
				}
			]
		}
	],
	"override": {
		"oidcc-prompt-login": {
			"browser": [
				{
					"comment": "the login page shown again is the screenshot the test asks for",
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "{ORIGIN}/login*",
							"commands": [
								["wait", "xpath", "//*", 10, "Log in", "update-image-placeholder-optional"],
								["text", "name", "username", "{USERNAME}"],
								["text", "name", "password", "{PASSWORD}"],
								["click", "name", "login"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				}
			]
		},
		"oidcc-max-age-1": {
			"browser": [
				{
					"comment": "the login page shown again is the screenshot the test asks for",
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Login",
							"optional": true,
							"match": "{ORIGIN}/login*",
							"commands": [
								["wait", "xpath", "//*", 10, "Log in", "update-image-placeholder-optional"],
								["text", "name", "username", "{USERNAME}"],
								["text", "name", "password", "{PASSWORD}"],
								["click", "name", "login"]
							]
						},
						{
							"task": "Verify Complete",
							"match": "*/test/*/callback*",
							"commands": [["wait", "id", "submission_complete", 10]]
						}
					]
				}
			]
		},
		"oidcc-ensure-registered-redirect-uri": {
			"browser": [
				{
					"comment": "the provider answers the request itself, refused, never redirecting",
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Expect the redirect URI refused",
							"match": "{ORIGIN}/oauth/authorize*",
							"commands": [
								[
									"wait",
									"xpath",
									"//*",
									10,
									"redirect_uri is not registered",
									"update-image-placeholder"
								]
							]
						}
					]
				}
			]
		},
		"oidcc-ensure-request-object-with-redirect-uri": {
			"browser": [
				{
					"comment": "the provider answers the request itself, refused, never redirecting",
					"match": "{ORIGIN}/oauth/authorize*",
					"tasks": [
						{
							"task": "Expect the redirect URI refused",
							"match": "{ORIGIN}/oauth/authorize*",
							"commands": [
								[
									"wait",
									"xpath",
									"//*",
									10,
									"redirect_uri is not registered",
									"update-image-placeholder"
								]
							]
						}
					]
				}
			]
		}
	}
}
