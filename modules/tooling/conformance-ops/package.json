{
	"name": "@mod/conformance-ops",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "verification",
	"exports": {
		".": "./src/main.ts"
	},
	"scripts": {
		"conformance": "vitest run --config vitest.config.ts",
		"conformance:faults": "SPEC_EVIDENCE_RUN=faults vitest run --config vitest.faults.config.ts",
		"evidence-runs": "node -p \"JSON.stringify([{ entry: '@mod/conformance-ops#faults', kind: 'faults', matrix: '@mod/conformance-ops', files: '.faults.case.ts', noSkip: true }])\""
	},
	"dependencies": {
		"@mod/conformance": "workspace:*",
		"@mod/conformance-keys": "workspace:*",
		"@mod/conformance-legacy": "workspace:*",
		"@mod/conformance-oauth": "workspace:*"
	},
	"devDependencies": {
		"@mod/spec-checklist": "workspace:*",
		"vitest": "5.1.0"
	}
}
