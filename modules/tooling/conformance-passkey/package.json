{
	"name": "@mod/conformance-passkey",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "verification",
	"exports": {
		".": "./src/main.ts"
	},
	"scripts": {
		"conformance": "vitest run --config vitest.config.ts",
		"conformance:faults": "SPEC_EVIDENCE_RUN=faults vitest run --config vitest.faults.config.ts",
		"evidence-runs": "node -p \"JSON.stringify([{ entry: '@mod/conformance-passkey#faults', kind: 'faults', matrix: '@mod/conformance-passkey', files: '.faults.case.ts', noSkip: true }])\""
	},
	"dependencies": {
		"@mod/conformance": "workspace:*",
		"@mod/conformance-legacy": "workspace:*",
		"@mod/conformance-oauth": "workspace:*",
		"@mod/ledger-fakes": "workspace:*",
		"vitest": "5.0.5"
	},
	"devDependencies": {
		"@mod/conformance-code": "workspace:*",
		"@mod/conformance-identity": "workspace:*",
		"@mod/conformance-keys": "workspace:*",
		"@mod/conformance-second-factor": "workspace:*",
		"@mod/spec-checklist": "workspace:*",
		"@mod/webauthn": "workspace:*",
		"jose": "6.2.13"
	}
}
