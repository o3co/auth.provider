{
	"name": "@mod/users-http",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "adapter",
	"narrower": "internal",
	"adapts": "@mod/users",
	"asks": [
		"Users from an outside ledger (`users-http.verify-url`, `users-http.credential`).",
		"`users-http.subject-url`: the lookup by subject; without it, every lookup by subject is unanswerable.",
		"`users-http.upstream-url`: the lookup by upstream identity, whose answer is the last word; without it, users reads its own links."
	],
	"exports": {
		"./module": "./src/module.ts"
	},
	"dependencies": {
		"@mod/kernel": "workspace:*",
		"@mod/keys": "workspace:*",
		"@mod/ledger-wire": "workspace:*",
		"@mod/outbound": "workspace:*",
		"@mod/outbound-policy": "workspace:*",
		"@mod/url-setting": "workspace:*",
		"@mod/users": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@mod/secret-hash": "workspace:*",
		"@mod/tls-options": "workspace:*",
		"vitest": "5.0.5"
	}
}
