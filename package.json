{
	"name": "auth-provider-workspace",
	"version": "0.18.0-rc.1",
	"private": true,
	"license": "Apache-2.0",
	"keywords": [
		"oauth2",
		"openid-connect",
		"oidc",
		"authorization-server",
		"identity-provider",
		"self-hosted",
		"nodejs",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/o3co/auth.provider"
	},
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"test": "vitest run",
		"guard": "pnpm --filter @mod/guard run guard",
		"conformance": "pnpm -r --workspace-concurrency=1 --if-present run conformance",
		"conformance:patterns": "pnpm --filter @mod/conformance run patterns",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guard && pnpm distribution",
		"distribution": "pnpm --filter @mod/distribution run check",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"bundles": "pnpm --filter @mod/distribution run bundles",
		"release:check": "pnpm --filter @mod/distribution run release-check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "26.6.5",
		"typescript": "6.0.3",
		"vitest": "5.0.4"
	}
}
