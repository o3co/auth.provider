{
	"name": "auth-provider-workspace",
	"version": "0.19.2",
	"private": true,
	"license": "Apache-2.0",
	"keywords": [
		"oauth2",
		"openid-connect",
		"oidc",
		"authorization-server",
		"identity-provider",
		"self-hosted",
		"nodejs",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/o3co/auth.provider"
	},
	"type": "module",
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"test": "vitest run",
		"guard": "pnpm --filter @mod/guard run guard",
		"conformance": "pnpm -r --workspace-concurrency=1 --if-present run conformance",
		"conformance:patterns": "pnpm --filter @mod/conformance run patterns",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm guard && pnpm distribution",
		"distribution": "pnpm --filter @mod/distribution run check",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"bundles": "pnpm --filter @mod/distribution run bundles",
		"api-docs": "pnpm --filter @mod/api-docs run api-docs",
		"release:check": "pnpm --filter @mod/distribution run release-check",
		"release:pack": "pnpm --filter @mod/distribution run release-pack",
		"release:published": "pnpm --filter @mod/distribution run release-published",
		"release:evidence-fetch": "pnpm --filter @mod/distribution run release-evidence-fetch",
		"release:evidence-judge": "pnpm --filter @mod/distribution run release-evidence-judge",
		"release:sbom": "pnpm --filter @mod/distribution run release-sbom",
		"release:scan": "pnpm --filter @mod/distribution run release-scan",
		"image:scan": "pnpm --filter @mod/distribution run image-scan",
		"release:listed": "pnpm --filter @mod/distribution run release-listed",
		"release:notes": "pnpm --filter @mod/distribution run release-notes"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "26.6.5",
		"fast-check": "4.10.2",
		"typescript": "6.0.3",
		"vitest": "5.1.0"
	}
}
